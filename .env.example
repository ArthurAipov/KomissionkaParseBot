# Never commit .env. Generate keys with: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_DB=watcher
POSTGRES_USER=watcher
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+psycopg://watcher:replace-with-a-random-password@db:5432/watcher
API_KEY=replace-with-a-random-api-key
BOT_TOKEN=
API_BASE_URL=http://api:8000

SCAN_INTERVAL_SECONDS=1800
REQUEST_DELAY_SECONDS=5
REQUEST_JITTER_SECONDS=2
REQUESTS_PER_HOUR=240
SNAPSHOT_LIMIT=15
PAGE_CACHE_SECONDS=300
BLOCK_COOLDOWN_SECONDS=21600
RESPECT_ROBOTS=false
CRAWLER_USER_AGENT=KomissionkiWatcher/0.1
LOG_LEVEL=INFO
PHOTO_CACHE_DIR=/app/media-cache
PHOTO_CACHE_MAX_MB=256
PHOTO_CACHE_TTL_SECONDS=604800
ADMIN_TELEGRAM_IDS=
CRAWL_PAGES_PER_TURN=3
DISK_WARN_FREE_MB=2048
